<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
>
    <testsuites>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- Module-owned tests live beside their module (ADR 0003). -->
            <directory>app/Modules/*/tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>app/Modules/*/tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_LOCALE" value="fa"/>
        <env name="APP_DISPLAY_TIMEZONE" value="Asia/Tehran"/>

        <!--
            Real PostgreSQL, never SQLite.

            Row-Level Security is the second line of tenancy defence (ADR 0002) and
            SQLite has no equivalent, so a suite running on SQLite would report green
            while proving nothing about the isolation guarantees this product sells.
            The `_test` database and its non-superuser role are provisioned by
            docker/postgres/init/.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="mobishop_test"/>
        <env name="DB_URL" value=""/>

        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="HASH_DRIVER" value="bcrypt"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="FILESYSTEM_DISK" value="local"/>

        <!-- Integrations must never reach the network from a test. -->
        <env name="SMS_DRIVER" value="null"/>
        <env name="MOADIAN_DRIVER" value="fake"/>
        <!-- Never touch a real gateway from a test. -->
        <env name="PAYMENT_DRIVER" value="fake"/>
        <env name="MOADIAN_ENABLED" value="false"/>
    </php>
</phpunit>
