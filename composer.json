{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mobishop/mobishop",
    "type": "project",
    "description": "MobiShop \u2014 multi-tenant SaaS for mobile-phone shops (Iran market).",
    "keywords": [
        "saas",
        "multi-tenant",
        "pos",
        "repairs",
        "iran"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/pennant": "^1.24",
        "laravel/tinker": "^2.10.1",
        "morilog/jalali": "^3.4",
        "picqer/php-barcode-generator": "^3.2",
        "pragmarx/google2fa": "^9.0",
        "shetabit/multipay": "^2.11",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^1.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": "pint .",
        "lint:test": [
            "pint --test .",
            "pint --test app config database routes tests bin"
        ],
        "stan": "phpstan analyse --memory-limit=1G",
        "rtl": "@php bin/check-direction-classes",
        "tenancy": "@php artisan tenancy:check --ansi",
        "test:pest": "pest",
        "test:isolation": [
            "@php artisan config:clear --ansi",
            "pest --group=isolation"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:test",
            "@rtl",
            "@stan",
            "@test:pest",
            "@tenancy"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "lint": "Fix code style with Pint",
        "lint:test": "Check code style without writing",
        "stan": "Larastan level 8",
        "tenancy": "Golden rule 1 gate: RLS, BelongsToTenant and tenant_id indexes on every tenant table",
        "rtl": "Fail on physical direction classes (ml-/pl-/left-/text-left\u2026) \u2014 golden rule 9",
        "test": "Full quality gate: Pint + RTL grep + Larastan + Pest",
        "test:isolation": "Cross-tenant isolation suite only"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
