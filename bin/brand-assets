#!/usr/bin/env bash
set -euo pipefail

# Rasterise the tab mark into the icon set.
#
# The source is `public/favicon.svg` — the wordmark's first letter, white on the brand
# tile, itself generated from the logo's outlines (see docs/design-system.md). It is
# already a finished, padded, rounded tile, so everything below is a straight rasterise:
#
#   apple-touch-icon.png   180px, as iOS expects
#   icon-192.png / icon-512.png   the manifest icons
#   favicon.ico            32 and 16px in one file, for the browsers that still ask
#
# It used to composite a bare symbol onto a generated blue square at 64% and re-colour
# `currentColor` on the way. That symbol was retired on 2026-09-04 when the logo became a
# wordmark; there is nothing left to compose, and a script that builds a tile we already
# have is a second place for the tile to be wrong.
#
# One-off, run locally; the outputs are committed. rsvg-convert (librsvg) rasterises and
# Pillow packs the .ico, because neither ships with macOS and both are one brew away.

cd "$(dirname "$0")/.."

SRC="public/favicon.svg"

command -v rsvg-convert >/dev/null || { echo "  rsvg-convert missing — brew install librsvg" >&2; exit 1; }
python3 -c 'import PIL' 2>/dev/null || { echo "  Pillow missing — python3 -m pip install pillow" >&2; exit 1; }
[[ -f "$SRC" ]] || { echo "  $SRC does not exist — regenerate it first, see docs/design-system.md" >&2; exit 1; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

for spec in "180:public/apple-touch-icon.png" "192:public/icon-192.png" "512:public/icon-512.png"; do
  size="${spec%%:*}"; out="${spec#*:}"
  rsvg-convert -w "$size" -h "$size" "$SRC" -o "$out"
  echo "  $out  ${size}px"
done

rsvg-convert -w 32 -h 32 "$SRC" -o "$TMP/32.png"
rsvg-convert -w 16 -h 16 "$SRC" -o "$TMP/16.png"
python3 - "$TMP/32.png" "$TMP/16.png" public/favicon.ico <<'PY'
import sys
from PIL import Image

big, small, out = sys.argv[1], sys.argv[2], sys.argv[3]
Image.open(big).convert("RGBA").save(out, sizes=[(32, 32), (16, 16)])
PY
echo "  public/favicon.ico  32 + 16px"
