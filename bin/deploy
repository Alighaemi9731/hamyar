#!/usr/bin/env bash
#
# Hamyar — zero-downtime release.
#
#   bin/deploy ghcr.io/you/hamyar-app:9f2c1ab
#   bin/deploy <image> --rollback     # cut straight back, no migrations
#
# Run ON the server, from the directory holding compose.prod.yaml and .env.production.
#
# ## What "zero-downtime" actually means here
#
# One nginx, two application containers, and exactly one file deciding which is live.
# The new container is started beside the old one, migrated, warmed and health-checked
# BEFORE anything points at it; the cutover is a rewrite of one upstream file and
# `nginx -s reload`, which lets in-flight requests finish on the old worker instead of
# dropping them.
#
# If any step before the cutover fails, nothing has moved. The old container is still
# serving and the script exits non-zero. That is the whole design: every irreversible
# thing happens after every reversible one.
#
# ## That guarantee assumes the script reaches the end
#
# It is about the ORDER of the steps, and it buys nothing against the script simply
# stopping between two of them. Exactly one thing can do that from outside: the SSH
# session dying, taking its child with it.
#
# It happened on the first release cut this way (2026-08-21, main a0468324d). Traffic had
# been cut over to app_green, and steps 8 and 9 never ran — so **horizon and the scheduler
# were left down on the old image**, with nothing red anywhere to say so, and compose's
# mid-recreate rename left a container holding the name `mobishop-horizon-1` so the
# obvious retry failed with a name conflict on top of it. The site looked completely fine;
# it just stopped sending SMS.
#
# So do not run this over an interactive SSH session. `bin/release` starts it detached on
# the box with `nohup`, writes the exit code to a sentinel file and polls for that — a
# dropped connection then costs a reconnect instead of a half-deployed box. Running it by
# hand, do the same:
#
#   nohup sh -c 'bin/deploy <image>; echo $? > /tmp/deploy.done' > /tmp/deploy.log 2>&1 &
#
# ## The migration rule this cannot enforce
#
# For a few seconds both releases serve traffic against ONE database, already migrated.
# So a migration must be backward-compatible for one release: add a column, deploy,
# start writing it, deploy again, and only then stop reading the old one. Dropping a
# column in the same release that stops writing it takes the site down for the length
# of the overlap — and the failure is a 500 on the OLD container, which reads as a
# rollback candidate rather than as the new release's fault.

set -Eeuo pipefail

readonly COMPOSE_FILE="compose.prod.yaml"
readonly ENV_FILE=".env.production"
readonly UPSTREAM_FILE="docker/nginx/upstream/app.conf"
readonly RELEASE_PUBLIC="release/public"
readonly HEALTH_TIMEOUT=90

log()  { printf '\033[36m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

# Which side of the cutover a failure happened on changes the advice completely, and the
# first version of this trap gave the pre-cutover answer for both.
#
# Steps 8 (queue workers) and 9 (drain) run AFTER traffic has moved. A failure there —
# a compose name conflict, an OOM, a pull hiccup — printed "nothing was cut over; the
# previous release is still serving", which is the exact opposite of the truth, and it
# points whoever reads it away from the damage. That is the 2026-08-21 shape: the site
# looked perfect and had no queue workers.
#
# Initialised before the trap and never `readonly`: this runs under `set -u`, and a trap
# body that reads an unset variable dies INSIDE the handler, which swallows the message
# entirely and leaves a bare unbound-variable error in its place.
#
# The post-cutover branch deliberately does not print $LINENO. Failing commands go through
# the dc() wrapper, so with `set -E` the trap reports the line inside dc() rather than the
# step that failed. Name the damage instead of a misleading line number.
CUT_OVER=0
trap 'if (( CUT_OVER )); then
        die "failed AFTER the cutover — traffic IS on $IDLE ($IMAGE) and $LIVE is NOT serving. Horizon and the scheduler may be down or still on the old image: check \`docker compose -f '"'"'$COMPOSE_FILE'"'"' --env-file '"'"'$ENV_FILE'"'"' ps\` BEFORE anything else."
      else
        die "failed at line $LINENO — nothing was cut over; the previous release is still serving"
      fi' ERR

readonly IMAGE="${1:-}"
readonly MODE="${2:-}"
[[ -n "$IMAGE" ]] || die "usage: bin/deploy <image[:tag]> [--rollback]"

command -v docker >/dev/null || die "docker is not installed"
[[ -f "$COMPOSE_FILE" ]] || die "$COMPOSE_FILE not found — run this from the deploy directory"
[[ -f "$ENV_FILE" ]]     || die "$ENV_FILE not found — production configuration is not in the image, by design"

dc() { docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"; }

# ---------------------------------------------------------------- which slot ----
#
# Reality first, the upstream file second, and the two are cross-checked because they
# can disagree — with the file being the one that is wrong.
#
# `docker/nginx/upstream/app.conf` is BOTH runtime state and a tracked file. bin/deploy
# rewrites it at every cutover, and it is committed with the blue slot so that a first
# boot on a fresh box has something valid to read. So anything that puts the repository
# over the deploy directory — rsync, git pull, a fresh checkout, a config-management
# run — silently resets it to `app_blue` while `app_green` may be the slot actually
# serving. That is not hypothetical; it happened on the first staging box, between the
# first deploy and the second.
#
# Trusting the file alone in that state is an OUTAGE rather than a cosmetic error. LIVE
# and IDLE come out swapped, and step 2 runs `--force-recreate` against the container
# that is currently taking traffic — before the health check, before the cutover. The
# ordering guarantee this whole script is built on (every irreversible step happens
# after every reversible one) does not survive being lied to about which slot is idle.
#
# A running container is the stronger signal: after a successful deploy exactly one app
# container is up, because step 9 stops the other one.
# Split from the filter on purpose. As one pipeline under `set -Eeuo pipefail`, grep
# finding nothing exited 1 and the ERR trap aborted the whole script — so the first-boot
# and both-slots-down branches below, which this code goes on to handle explicitly, were
# unreachable. A recovery deploy after `docker compose down`, a failed recreate or an
# OOM-killed pair refused to start, and said "nothing was cut over" while nothing was
# serving at all.
#
# Compose failing to ANSWER is still fatal, and must stay fatal: trusting the upstream
# file after a failed `ps` is exactly how LIVE and IDLE come out swapped.
if ! running_all="$(dc ps --services --status running 2>&1)"; then
    die "could not list running services — docker compose said: $running_all"
fi
running_slots="$(printf '%s\n' "$running_all" | grep -E '^app_(blue|green)$' | sort | tr '\n' ' ' | sed 's/ $//' || true)"

if grep -q 'app_blue' "$UPSTREAM_FILE"; then
    file_slot=app_blue
else
    file_slot=app_green
fi

case "$running_slots" in
    app_blue|app_green)
        # Exactly one is up, so that is what nginx can be talking to whatever the file
        # says. Trust it, and say so loudly if the file disagreed.
        LIVE="$running_slots"
        if [[ "$LIVE" != "$file_slot" ]]; then
            log "WARNING: $UPSTREAM_FILE names $file_slot but only $LIVE is running."
            log "         Trusting the running container. Something reset the upstream"
            log "         file — syncing the repository over this directory does exactly"
            log "         that, because the file is tracked AND rewritten at cutover."
        fi
        ;;
    *)
        # Neither (a genuine first boot) or both (a previous deploy was interrupted
        # between cutover and drain). The file is the only signal left, and on a first
        # boot it is the correct one.
        LIVE="$file_slot"
        [[ -n "$running_slots" ]] && log "note: both app slots are running — a previous deploy did not finish draining"
        ;;
esac

if [[ "$LIVE" == "app_blue" ]]; then
    IDLE=app_green
else
    IDLE=app_blue
fi
readonly LIVE IDLE

log "live: $LIVE   →   deploying to: $IDLE"
log "image: $IMAGE"

# ------------------------------------------------------------------- 1. pull ----
#
# Present-locally is checked BEFORE pulling, because `compose pull` treats "this tag
# exists on no registry" as a hard error rather than as "it is already here" — so a
# locally built image fails at step 1 of 9, before anything has been attempted.
#
# That is not a hypothetical: this repository is private, so a registry deploy means
# issuing and rotating a pull token on every machine that deploys, and staging builds
# on the box instead. A registry tag is still pulled exactly as before; the difference
# is only that an image already on this host is accepted as one.
if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    log "image already present on this host — nothing to pull"
else
    log "pulling the image"
    APP_IMAGE="$IMAGE" dc pull "$IDLE" >/dev/null
fi
ok "image present"

# ------------------------------------------------------------- 2. start idle ----
#
# `--no-deps`: postgres and redis are already up and must not be recreated by a deploy.
log "starting $IDLE"
APP_IMAGE="$IMAGE" dc up -d --no-deps --force-recreate "$IDLE"

# --------------------------------------------------------------- 3. migrate ----
#
# Skipped on a rollback. Migrations do not run backwards here — reverting code to a
# release that predates a column is safe (it ignores it); running `migrate:rollback`
# during an incident is how data is lost.
if [[ "$MODE" == "--rollback" ]]; then
    log "rollback: skipping migrations (the schema stays forward)"
else
    log "running migrations"
    APP_IMAGE="$IMAGE" dc exec -T "$IDLE" php artisan migrate --force --no-interaction
    ok "schema up to date"
fi

# ----------------------------------------------------------------- 4. caches ----
#
# HERE, not at image build time. Caching config in the Dockerfile bakes the build
# machine's environment into the artefact — starting with APP_DOMAIN, which golden rule
# 1b requires to stay a configuration change (see docker/app/Dockerfile.prod).
log "warming caches"
APP_IMAGE="$IMAGE" dc exec -T "$IDLE" php artisan config:cache >/dev/null
APP_IMAGE="$IMAGE" dc exec -T "$IDLE" php artisan route:cache  >/dev/null
APP_IMAGE="$IMAGE" dc exec -T "$IDLE" php artisan view:cache   >/dev/null
ok "config, routes and views cached"

# --------------------------------------------------------- 5. publish assets ----
#
# Copied ADDITIVELY. Vite fingerprints filenames, so during the overlap a page served
# by the old container must still be able to fetch the files it references — deleting
# first would break every already-open tab for the length of the cutover.
#
# The stale files are pruned by bin/prune-releases, deliberately not from here: a
# deploy that also deletes is a deploy that can delete the wrong thing at 3am.
log "publishing assets"
mkdir -p "$RELEASE_PUBLIC"

# nginx runs as an unprivileged user inside its own container and only ever READS this
# directory, so it has to be traversable by somebody other than root. `mkdir` applies
# the invoking shell's umask, and a hardened box — or one operator command that ran
# under `umask 077` — leaves it 0700, which nginx cannot stat.
#
# The failure that produces is a bad one to be handed at 3am, because it does not look
# like a permission problem. php-fpm serves from its OWN copy of public/ inside the
# image, so every dynamic route keeps working; only the static files 403. The site
# renders with no stylesheet and no JavaScript and reads as "the deploy corrupted the
# assets" rather than "one directory is 0700". Cheap to assert, so assert it.
chmod 755 "$(dirname "$RELEASE_PUBLIC")" "$RELEASE_PUBLIC"

docker cp "$(dc ps -q "$IDLE")":/var/www/html/public/. "$RELEASE_PUBLIC"/
ok "assets published"

# ----------------------------------------------------------------- 6. health ----
#
# `artisan health:check` and not an HTTP request, because there is nothing here to make
# one against: the application container runs php-fpm, which speaks FastCGI, and going
# through nginx would mean cutting over first and checking afterwards.
#
# Same HealthCheck the /health endpoint serves, same grading — so a queue backlog does
# not block a deploy, and a dead Redis does. Exit code is the answer.
log "health-checking $IDLE (up to ${HEALTH_TIMEOUT}s)"
deadline=$(( SECONDS + HEALTH_TIMEOUT ))
until APP_IMAGE="$IMAGE" dc exec -T "$IDLE" php artisan health:check >/dev/null 2>&1; do
    (( SECONDS < deadline )) || {
        log "still unhealthy after ${HEALTH_TIMEOUT}s — the detail follows"
        APP_IMAGE="$IMAGE" dc exec -T "$IDLE" php artisan health:check || true
        die "$IDLE never became healthy; it has NOT been cut over and $LIVE is still serving"
    }
    sleep 3
done
ok "$IDLE is healthy"

# ----------------------------------------------------------------- 7. cutover ----
#
# The only irreversible step, and it is one file and one signal. `reload` rather than
# `restart`: workers holding an open request finish it on the old configuration.
log "cutting traffic over to $IDLE"
cat > "$UPSTREAM_FILE" <<UPSTREAM
# Written by bin/deploy on $(date -u +%Y-%m-%dT%H:%M:%SZ) — do not edit by hand.
# Release: $IMAGE
upstream hamyar_app {
    server ${IDLE}:9000;
}
UPSTREAM
dc exec -T nginx nginx -t
dc exec -T nginx nginx -s reload
CUT_OVER=1
ok "traffic is on $IDLE"

# ------------------------------------------------------------------ 8. queue ----
#
# AFTER the cutover, not before. `horizon:terminate` waits for the running job to
# finish and then exits so the supervisor restarts it on the new image — restarting it
# earlier would have workers on the new code while the web tier is still on the old.
log "restarting queue workers on the new release"
APP_IMAGE="$IMAGE" dc up -d --no-deps --force-recreate horizon scheduler
ok "horizon and scheduler restarted"

# ------------------------------------------------------------------ 9. drain ----
#
# The old container is STOPPED, not removed, and this is the rollback path: it still
# holds the previous image, so `bin/deploy <previous-image> --rollback` is a cutover
# and not a rebuild.
log "draining $LIVE"
sleep 5
dc stop "$LIVE" >/dev/null
ok "$LIVE stopped"

printf '\n'
ok "deployed $IMAGE  ($LIVE → $IDLE)"
printf '  rollback:  bin/deploy <previous-image> --rollback\n\n'
