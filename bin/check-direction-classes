#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * MobiShop — RTL direction-class gate.
 *
 * Golden rule 9 / design-system rule 1: the UI is right-to-left, so only *logical*
 * utilities are allowed (ms-/me-/ps-/pe-/start-/end-/text-start/text-end/border-s/
 * border-e/rounded-s/rounded-e). A physical utility (ml-, pl-, left-, text-left, …)
 * silently mirrors the layout for Persian users, which is why this is a build failure
 * rather than a lint warning.
 *
 * Wired into `composer test` as the `rtl` script, and into CI before static analysis.
 *
 * Escape hatch: put `rtl-allow` in a comment on the same line, or on the line
 * immediately above (long className strings are one very long line, so an inline
 * comment is not always possible). Use it only for genuinely physical cases — a
 * Sheet whose API takes side="left", a print template pinned to a paper edge — and
 * always say why.
 */

const SCAN_ROOTS = ['resources', 'app', 'routes'];

const SCAN_EXTENSIONS = ['ts', 'tsx', 'js', 'jsx', 'css', 'php', 'blade.php', 'html'];

/**
 * Physical utilities and their logical replacements.
 *
 * Each rule declares how the class is spelled, which is what keeps English prose in
 * comments from tripping the gate:
 *
 *   'value'    prefix REQUIRES a Tailwind value  → `ml-4`, `left-[3px]`, `-mr-2`
 *   'optional' prefix may take one               → `border-l`, `border-l-2`
 *   'exact'    complete class name               → `text-left`, `float-right`
 *
 * Matching a value rather than "any word characters" is the difference between
 * flagging `left-0` (a bug) and flagging `left-to-right` (a sentence).
 */
const RULES = [
    ['ml-', 'ms-', 'value'],
    ['mr-', 'me-', 'value'],
    ['pl-', 'ps-', 'value'],
    ['pr-', 'pe-', 'value'],
    ['left-', 'start-', 'value'],
    ['right-', 'end-', 'value'],
    ['scroll-ml-', 'scroll-ms-', 'value'],
    ['scroll-mr-', 'scroll-me-', 'value'],
    ['scroll-pl-', 'scroll-ps-', 'value'],
    ['scroll-pr-', 'scroll-pe-', 'value'],
    ['inset-l-', 'inset-s-', 'value'],
    ['inset-r-', 'inset-e-', 'value'],

    ['border-l', 'border-s', 'optional'],
    ['border-r', 'border-e', 'optional'],
    ['rounded-l', 'rounded-s', 'optional'],
    ['rounded-r', 'rounded-e', 'optional'],

    ['text-left', 'text-start', 'exact'],
    ['text-right', 'text-end', 'exact'],
    ['float-left', 'float-start', 'exact'],
    ['float-right', 'float-end', 'exact'],
    ['clear-left', 'clear-start', 'exact'],
    ['clear-right', 'clear-end', 'exact'],
];

/**
 * What can legally follow a physical prefix in Tailwind: a numeric scale step, a
 * keyword, an arbitrary `[…]` value, or a CSS variable `(--x)`.
 */
const VALUE = '(?:\d[\w./%]*|auto|full|px|screen|min|max|fit|reverse|dvw|dvh|\[[^\]\s]*\]|\([^)\s]*\))';

/** Paths that never contain our own utility classes. */
const EXCLUDED = [
    'node_modules',
    'vendor',
    'resources/js/components/ui/__generated',
];

/**
 * @return list<string>
 */
function collectFiles(string $root): array
{
    if (! is_dir($root)) {
        return [];
    }

    $files = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS)
    );

    /** @var SplFileInfo $file */
    foreach ($iterator as $file) {
        if (! $file->isFile()) {
            continue;
        }

        $path = $file->getPathname();

        foreach (EXCLUDED as $excluded) {
            if (str_contains($path, $excluded)) {
                continue 2;
            }
        }

        foreach (SCAN_EXTENSIONS as $extension) {
            if (str_ends_with($path, '.'.$extension)) {
                $files[] = $path;

                continue 2;
            }
        }
    }

    sort($files);

    return $files;
}

/**
 * Build one regex per physical utility.
 *
 * Matches a class token only when it starts at a class boundary — the start of the
 * string, whitespace, a quote, a backtick, `{`, or a Tailwind variant separator
 * (`sm:`, `hover:`, `rtl:`) — so prose and identifiers are not flagged.
 */
function patternFor(string $utility, string $kind): string
{
    // `~` as the delimiter: VALUE contains `/` (for fractions like `ml-1/2`), which
    // would otherwise close a `/`-delimited pattern early.
    $escaped = preg_quote($utility, '~');

    $tail = match ($kind) {
        'value' => VALUE.'(?![\w-])',
        'optional' => '(?:-'.VALUE.')?(?![\w-])',
        default => '(?![\w-])',
    };

    // A class token starts at the start of the line, after whitespace, a quote, a
    // backtick, `{`, `[`, or a Tailwind variant separator (`sm:`, `rtl:`) — plus the
    // negative form, where a leading `-` sits at one of those same boundaries.
    //
    // The second alternative must require a boundary BEFORE the `-`, otherwise
    // `slide-in-from-left-2` (a legitimate compound utility) reads as `left-2`.
    $boundary = '(?:(?<=^|[\s"\'`{:\[])|(?<=[\s"\'`{:\[]-))';

    return '~'.$boundary.$escaped.$tail.'~';
}

$violations = [];
$scanned = 0;

foreach (SCAN_ROOTS as $root) {
    foreach (collectFiles($root) as $path) {
        $scanned++;

        $lines = file($path, FILE_IGNORE_NEW_LINES);

        if ($lines === false) {
            continue;
        }

        foreach ($lines as $index => $line) {
            $previous = $lines[$index - 1] ?? '';

            if (str_contains($line, 'rtl-allow') || str_contains($previous, 'rtl-allow')) {
                continue;
            }

            foreach (RULES as [$physical, $logical, $kind]) {
                if (preg_match(patternFor($physical, $kind), $line, $matches) === 1) {
                    $violations[] = [
                        'file' => $path,
                        'line' => $index + 1,
                        'found' => $matches[0],
                        'use' => $logical,
                        'source' => trim($line),
                    ];
                }
            }
        }
    }
}

if ($violations === []) {
    fwrite(STDOUT, "  RTL gate: no physical direction classes in {$scanned} files.\n");
    exit(0);
}

fwrite(STDERR, "\n  RTL gate FAILED — physical direction classes are a bug (golden rule 9).\n\n");

foreach ($violations as $violation) {
    $source = mb_strimwidth($violation['source'], 0, 110, '…');

    fwrite(STDERR, sprintf(
        "  %s:%d\n    found `%s` — use `%s` instead\n    %s\n\n",
        $violation['file'],
        $violation['line'],
        $violation['found'],
        $violation['use'],
        $source,
    ));
}

fwrite(STDERR, sprintf(
    "  %d violation(s). Logical utilities only: ms/me/ps/pe/start/end/text-start/text-end.\n".
    "  If a line is genuinely direction-independent, add a `rtl-allow` comment explaining why.\n\n",
    count($violations),
));

exit(1);
