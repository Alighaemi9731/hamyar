#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Hamyar — global-helper collision gate.
 *
 * ## The rule
 *
 * A `function_exists`-guarded global helper of ours must not take a name that a vendor
 * package also defines globally. Both definitions are guarded, so **whichever file
 * autoloads first wins** — and Composer loads vendor `files` before the application's.
 * Ours loses, silently, and stays dead.
 *
 * ## The occurrence this exists for
 *
 * `App\Support\helpers.php` defined `jdate()`. **morilog/jalali defines `jdate()` too.**
 * Ours was dead code for eight phases and looked live: it returned
 * `1405-06-02 21:18:47` — the package's shape, with a time on it — where every screen in
 * this product renders `۱۴۰۵/۰۶/۰۲`. Nothing called it until a Blade view did, and the
 * defect surfaced as a wrong-looking date on a public page rather than as an error.
 *
 * Same family as `bindIf` versus `bind`, and as enforcement-with-no-writer: nothing
 * crashes, the wrong implementation just wins a name.
 *
 * ## How it checks
 *
 * `vendor/composer/autoload_files.php` is the authoritative list of files Composer loads
 * globally — every package that ships helpers is in it. This reads that list, collects the
 * function names those files define, and compares them against ours. No guessing, no
 * hardcoded package list: a dependency added next month is covered the day it lands.
 */

const OUR_HELPER_FILES = ['app/Support/helpers.php'];

$root = dirname(__DIR__);
$autoloadFiles = $root.'/vendor/composer/autoload_files.php';

if (! is_file($autoloadFiles)) {
    echo "\n  ✗ Global-helper gate: vendor/composer/autoload_files.php is missing.\n";
    echo "    Run `composer install` first.\n\n";

    exit(1);
}

/** @var array<string, string> $files */
$files = require $autoloadFiles;

/**
 * Function names a PHP file defines at global scope.
 *
 * Token-based rather than regex: `function` also appears in closures, in `use function`
 * imports and inside strings, and a regex over those produces false positives that make a
 * gate people switch off.
 *
 * @return list<string>
 */
function globalFunctionsIn(string $path): array
{
    $source = @file_get_contents($path);

    if ($source === false) {
        return [];
    }

    $tokens = token_get_all($source);
    $names = [];
    $namespaceDepth = 0;
    $inNamespace = false;

    foreach ($tokens as $index => $token) {
        if (is_array($token) && $token[0] === T_NAMESPACE) {
            // A namespaced function is not a global one and cannot collide.
            $inNamespace = true;
        }

        if (! is_array($token) || $token[0] !== T_FUNCTION) {
            continue;
        }

        // The next meaningful token is the name — unless it is `(` (a closure) or `&`.
        for ($next = $index + 1; $next < count($tokens); $next++) {
            $candidate = $tokens[$next];

            if (is_array($candidate) && in_array($candidate[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) {
                continue;
            }

            if (is_array($candidate) && $candidate[0] === T_STRING) {
                $names[] = $candidate[1];
            }

            break;
        }
    }

    return $inNamespace ? [] : array_values(array_unique($names));
}

$ours = [];

foreach (OUR_HELPER_FILES as $relative) {
    foreach (globalFunctionsIn($root.'/'.$relative) as $name) {
        $ours[$name] = $relative;
    }
}

if ($ours === []) {
    echo "\n  Global-helper gate: no application helpers declared.\n\n";

    exit(0);
}

$collisions = [];

foreach ($files as $vendorFile) {
    $real = realpath($vendorFile);

    if ($real === false || ! str_contains($real, DIRECTORY_SEPARATOR.'vendor'.DIRECTORY_SEPARATOR)) {
        continue;
    }

    foreach (globalFunctionsIn($real) as $name) {
        if (! isset($ours[$name])) {
            continue;
        }

        $collisions[] = [
            'name' => $name,
            'ours' => $ours[$name],
            'theirs' => ltrim(str_replace($root, '', $real), DIRECTORY_SEPARATOR),
        ];
    }
}

if ($collisions === []) {
    $count = count($ours);

    echo "\n  Global-helper gate: {$count} application helpers, none shadowed by a vendor global.\n\n";

    exit(0);
}

echo "\n  ✗ Global-helper gate failed.\n\n";
echo "    These helpers share a name with a globally-autoloaded vendor function. Both are\n";
echo "    `function_exists`-guarded, Composer loads vendor files FIRST, so ours never runs —\n";
echo "    it is dead code that looks live.\n\n";

foreach ($collisions as $collision) {
    echo "      {$collision['name']}()\n";
    echo "        ours:   {$collision['ours']}\n";
    echo "        theirs: {$collision['theirs']}  ← this one wins\n\n";
}

echo "    Rename ours. `jdate()` became `jalali()` for exactly this reason.\n\n";

exit(1);
