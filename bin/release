#!/usr/bin/env bash
#
# Hamyar — cut a release, and optionally put it on the box.
#
#   bin/release                 # verify and tag whatever VERSION says, publish the release
#   bin/release --deploy        # …then sync, build on the box, cut over, and smoke it
#   bin/release --dry-run       # print every step, change nothing
#
# ## The shape, and why it is this shape
#
# A release here is NOT a commit. `VERSION` and the `CHANGELOG.md` entry are written in
# the same pull request as the change they describe, so by the time a release happens
# `main` already holds everything and this script only has to *publish* it: tag, GitHub
# release, deploy, prove.
#
# That is deliberate. The alternative — bump the version in a commit pushed straight to
# `main` at release time — needs `ALLOW_MAIN_PUSH=1` every single time, and a guard whose
# override is part of the routine is not a guard. A tag is not `refs/heads/main`, so
# nothing has to be waved through here.
#
# ## What it refuses to do
#
# Every check below exists because its absence produced a real, visible fault on
# 2026-08-21, when twenty-one finished commits sat on a branch while the box served the
# release before them and every check was green:
#
#   - it will not tag a commit whose CI is not green;
#   - it will not tag a version with no CHANGELOG entry;
#   - it will not release while a GREEN pull request is sitting unmerged, because that is
#     the exact state that produced the mess (override: ALLOW_UNMERGED_GREEN=1);
#   - it will not call a deploy successful until `bin/smoke` has confirmed, over the
#     public internet, that the box is serving THIS version.
#
# ## What it never touches
#
# `.env.production` and `certbot/` live only on the box. `docker/nginx/upstream/app.conf`
# is tracked AND runtime state — syncing it resets the live blue/green slot — so it is
# excluded from the rsync. See `docs/deploy.md` §3.

set -Eeuo pipefail

# Assigned then marked readonly, not both at once: `readonly X="$(cmd)"` takes the exit
# status of `readonly`, never of the command, so a failing substitution silently yields an
# empty value that the next line uses (SC2155).
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
cd "$REPO_ROOT"

DEPLOY=0
DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --deploy)  DEPLOY=1 ;;
        --dry-run) DRY_RUN=1 ;;
        *) printf 'unknown argument: %s\n' "$arg" >&2; exit 2 ;;
    esac
done

log()  { printf '\033[36m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*"; }
die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
run()  { if (( DRY_RUN )); then printf '\033[90m   would run: %s\033[0m\n' "$*"; else "$@"; fi; }

(( DRY_RUN )) && warn "dry run — nothing will be pushed, published or deployed"

# ============================================================== 1. preflight ====
log "preflight"

command -v gh    >/dev/null || die "the GitHub CLI (gh) is not installed"
command -v git   >/dev/null || die "git is not installed"
command -v rsync >/dev/null || die "rsync is not installed"

gh auth status >/dev/null 2>&1 || die "gh is not authenticated — run 'gh auth login'"

[[ -f VERSION ]] || die "VERSION is missing"
VERSION="$(tr -d '[:space:]' < VERSION)"
readonly VERSION
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || die "VERSION is not a semantic version: '$VERSION' (see docs/VERSIONING.md)"
readonly TAG="v$VERSION"

branch="$(git rev-parse --abbrev-ref HEAD)"
default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
default_branch="${default_branch:-main}"

[[ "$branch" == "$default_branch" ]] \
    || die "on '$branch' — a release is cut from '$default_branch'. Merge the PR first."

[[ -z "$(git status --porcelain --untracked-files=no)" ]] \
    || die "the worktree has uncommitted changes — a release must be exactly what is on $default_branch"

# Untracked files do not block a release — what goes to the box is an export of the tag
# (see "the tree that ships is the tag" below), so they cannot reach it. Say so anyway:
# before that change they were rsynced into the production image while being absent from
# the tag and the published tarball, and silence here is what made that invisible.
if [[ -n "$(git status --porcelain --untracked-files=normal | grep '^??' || true)" ]]; then
    warn "untracked files present; they are NOT part of $TAG and will not be deployed:"
    git status --porcelain --untracked-files=normal | grep '^??' | sed 's/^?? /    /'
fi

git fetch --quiet origin "$default_branch" --tags
HEAD_SHA="$(git rev-parse HEAD)"
readonly HEAD_SHA

[[ "$HEAD_SHA" == "$(git rev-parse "origin/$default_branch")" ]] \
    || die "$default_branch and origin/$default_branch differ — pull, or push, before releasing"

# ------------------------------------------------------------ resume, not refuse ----
#
# An existing tag means one of two completely different things, and the first draft of
# this script treated both as the same mistake.
#
# If it points somewhere OTHER than HEAD, somebody forgot to bump VERSION — refuse, which
# is what the guard was for. If it points at HEAD, this exact release was already tagged
# and the run that tagged it did not finish. Everything after the tag can fail: the rsync,
# a cold `docker build` running past the poll budget, the cutover, a dropped link. Refusing
# there left the tag and the published GitHub release announcing a version the box was not
# serving, with the ONE command that deploys refusing to run — recoverable only by deleting
# a published release by hand, or by burning a version number on a release containing no
# changes.
#
# It also made the two-step usage this script prints at the end of a non-deploy run
# (`bin/release`, then `bin/release --deploy`) impossible: the first run creates the tag
# locally, so the second died here every time, on a perfect network.
#
# So: resume. Phase 2 below is idempotent throughout — tag, push, archive and release each
# check for their own prior result. The preflight above is deliberately NOT skipped on a
# resume; it is cheap, it is still true about the commit being shipped, and skipping it
# would make resuming a way around the gates.
RESUMING=0
if git rev-parse --verify --quiet "refs/tags/$TAG" >/dev/null; then
    tagged_sha="$(git rev-list -n1 "refs/tags/$TAG")"
    [[ "$tagged_sha" == "$HEAD_SHA" ]] \
        || die "$TAG already exists and points at ${tagged_sha:0:9}, not HEAD (${HEAD_SHA:0:9}). Bump VERSION and add a CHANGELOG entry (docs/VERSIONING.md)."

    remote_sha="$(git ls-remote --tags origin "refs/tags/$TAG^{}" | cut -f1)"
    [[ -z "$remote_sha" || "$remote_sha" == "$HEAD_SHA" ]] \
        || die "origin's $TAG points at ${remote_sha:0:9}, not HEAD — resolve that by hand before releasing."

    RESUMING=1
    warn "$TAG already exists at HEAD — resuming a release that was published but not finished"
fi
readonly RESUMING

ok "on $default_branch at ${HEAD_SHA:0:9}, clean, in sync with origin"

# ------------------------------------------------ the changelog entry exists ----
#
# Asserted rather than trusted: an entry written after the fact is written from the diff,
# and the diff is the one thing that cannot say WHY.
[[ -f CHANGELOG.md ]] || die "CHANGELOG.md is missing"
grep -qE "^## +${VERSION//./\\.} " CHANGELOG.md \
    || die "CHANGELOG.md has no '## $VERSION …' entry — write it before releasing"
ok "CHANGELOG.md describes $VERSION"

# ------------------------------------------------------- no green PR left open ----
#
# The root cause of 2026-08-21, made mechanical. A pull request whose every check has
# passed is a finished piece of work that nobody is looking at, and the law this project
# now runs on is: green means merge, and merge means deploy. Drafts are exempt — a draft
# is a statement that it is not finished.
# Fails CLOSED. The first draft swallowed gh's exit status with `2>/dev/null || true`, and
# because "no green PR" and "could not ask" are both the empty string, an API hiccup read
# as a pass — the gate reporting green precisely when it could not see. Every gate below
# is written the same way: test the EXIT STATUS, never the emptiness of the output, because
# empty is a legitimate success value for all three of them.
if ! green_open="$(
    gh pr list --state open --draft=false --json number,title,statusCheckRollup \
        --jq '[ .[]
                | select((.statusCheckRollup | length) > 0)
                | select([ .statusCheckRollup[]
                           | select((.conclusion // .state // "PENDING") | ascii_upcase
                                    | . != "SUCCESS" and . != "NEUTRAL" and . != "SKIPPED") ] | length == 0)
                | "#\(.number) \(.title)" ] | .[]'
)"; then
    [[ "${ALLOW_UNMERGED_GREEN:-}" == "1" ]] \
        || die "could not query open pull requests — refusing to release blind (override: ALLOW_UNMERGED_GREEN=1)"
    warn "could not query open pull requests; proceeding because ALLOW_UNMERGED_GREEN=1"
    green_open=''
fi

# Echo the operator's own flags back. `${DEPLOY:+…}` expanded whichever way DEPLOY was set,
# because "0" is not empty — so a plain `bin/release` was handed a copy-paste line that
# also cuts over production, at the one moment the operator is being told to slow down.
hint_flags=''
if (( DEPLOY )); then hint_flags+=' --deploy'; fi
if (( DRY_RUN )); then hint_flags+=' --dry-run'; fi

if [[ -n "$green_open" ]]; then
    if [[ "${ALLOW_UNMERGED_GREEN:-}" == "1" ]]; then
        warn "releasing with green pull requests still open (ALLOW_UNMERGED_GREEN=1):"
        printf '    %s\n' "$green_open"
    else
        printf '\033[31m✗ a green pull request is sitting unmerged:\033[0m\n' >&2
        printf '    %s\n' "$green_open" >&2
        cat >&2 <<EOF

  Green means merge, and merge means deploy (CLAUDE.md). Twenty-one finished commits sat
  on a branch this way while the box served the release before them — nothing was red,
  the site was just wrong.

  Merge it:            gh pr merge <number> --squash --delete-branch
  Or say so out loud:  ALLOW_UNMERGED_GREEN=1 bin/release${hint_flags}

EOF
        exit 1
    fi
else
    ok "no green pull request left unmerged"
fi

# ------------------------------------------------------------------ CI is green ----
#
# The gate that counts, on the commit being tagged — not on "a recent run", and not on
# the laptop. This project's suite runs on GitHub's machines by owner's instruction.
log "checking CI on ${HEAD_SHA:0:9}"

# `gh api --jq` rather than a pipe into jq(1): gh carries its own, so this needs one
# fewer thing installed on whichever machine cuts a release.
#
# stderr is NOT discarded, and every call is checked. The first draft made three separate
# HTTP requests and guarded only the first: `pending` fell back to `echo 0` and `failed` to
# the empty string, which are exactly the values that mean "nothing pending" and "nothing
# red". A 502 or a secondary rate limit between request one and request two therefore
# printed `✓ all N checks passed` for a commit whose tests were still running — the gate
# CLAUDE.md calls "the gate that counts", reporting success at the moment it went blind.
api_checks() { gh api "repos/{owner}/{repo}/commits/$HEAD_SHA/check-runs" --jq "$1"; }
blind() { die "could not read check runs for ${HEAD_SHA:0:9} — refusing to release blind"; }

total="$(api_checks '.check_runs | length')" || blind
[[ "$total" != "0" ]] || die "no CI run exists for ${HEAD_SHA:0:9} — push it and wait, do not release blind"

pending="$(api_checks '[.check_runs[] | select(.status != "completed")] | length')" || blind
[[ "$pending" == "0" ]] || die "CI is still running on ${HEAD_SHA:0:9} ($pending job(s)) — wait for it"

# `!= success` rather than a list of known-bad conclusions: cancelled, timed_out,
# action_required and stale are all "not a pass", and enumerating failures means the next
# conclusion GitHub invents is silently a pass.
#
# Read line by line, never word by word: every job name in this workflow has a space in
# it ("Pest (PostgreSQL 16)"), so splitting on whitespace reports four broken checks
# where there is one.
failed="$(api_checks '.check_runs[] | select(.conclusion != "success" and .conclusion != "neutral" and .conclusion != "skipped") | .name')" || blind

if [[ -n "$failed" ]]; then
    printf '\033[31m✗ CI is red on %s:\033[0m\n' "${HEAD_SHA:0:9}" >&2
    while IFS= read -r name; do
        [[ -n "$name" ]] && printf '    %s\n' "$name" >&2
    done <<<"$failed"
    die "fix it forward; a red commit is not a release"
fi
ok "all $total checks passed on ${HEAD_SHA:0:9}"

# =========================================================== 2. tag & publish ====
log "tagging $TAG"

# The entry's headline, not its date. `## 0.12.0 - 2026-08-22` carries no title on that
# line — the title is the bolded sentence that opens the body — so stripping the heading
# left "2026-08-22" and every tag and release was named after the day it was cut.
changelog_title="$(
    awk -v v="$VERSION" '
        $0 ~ "^## +"v"( |$)" { grabbing = 1; next }
        grabbing && /^## / { exit }
        grabbing && /\*\*/ {
            line = $0
            sub(/^[^*]*\*\*/, "", line)
            sub(/\*\*.*$/, "", line)
            print line
            exit
        }
    ' CHANGELOG.md | head -c 100
)"

# Idempotent from here down. Everything below can fail with the tag already on origin and
# the release already published, and the operator's only way forward is to run this again.
(( RESUMING )) || run git tag -a "$TAG" -m "$TAG — ${changelog_title:-release}"
# Always pushed, never conditional: a tag created locally by a run that died before the
# push must still reach origin on the resume.
run git push origin "refs/tags/$TAG"
ok "tag pushed"

# A checksum-verifiable archive of exactly this tree. The deploy below does not consume
# it — that path is rsync-and-build (docs/deploy.md §3) — so its job is provenance: the
# artefact that says what $TAG contained, independently of whichever machine last synced.
readonly DIST="dist-release"
readonly ASSET="hamyar-$TAG.tar.gz"
run mkdir -p "$DIST"
if (( ! DRY_RUN )); then
    git archive --format=tar.gz --prefix="hamyar-$TAG/" "$TAG" > "$DIST/$ASSET"
    ( cd "$DIST" && (shasum -a 256 "$ASSET" > "$ASSET.sha256" 2>/dev/null || sha256sum "$ASSET" > "$ASSET.sha256") )
    ok "built $DIST/$ASSET ($(du -h "$DIST/$ASSET" | cut -f1))"
else
    printf '\033[90m   would run: git archive … > %s/%s (+ .sha256)\033[0m\n' "$DIST" "$ASSET"
fi

log "publishing the GitHub release"
if (( DRY_RUN )); then
    printf '\033[90m   would run: gh release create %s --generate-notes …\033[0m\n' "$TAG"
else
    notes_file="$(mktemp)"
    # The CHANGELOG entry IS the release note. --generate-notes would list commit
    # subjects, which describe the diff; the entry describes the decision.
    awk -v v="$VERSION" '
        $0 ~ "^## +"v" " { grabbing = 1; next }
        grabbing && /^## / { exit }
        grabbing { print }
    ' CHANGELOG.md > "$notes_file"

    # `gh release create` refuses an existing release, so on a resume this would be the
    # next thing to kill the run after the tag guard stopped doing it.
    if gh release view "$TAG" >/dev/null 2>&1; then
        gh release upload "$TAG" "$DIST/$ASSET" "$DIST/$ASSET.sha256" --clobber
        ok "release $TAG was already published — assets refreshed"
    else
        gh release create "$TAG" \
            --title "$TAG — ${changelog_title:-release}" \
            --notes-file "$notes_file" \
            "$DIST/$ASSET" "$DIST/$ASSET.sha256"
        ok "released $TAG"
    fi
    rm -f "$notes_file"
fi

# From this line on, the tag and the release are public and the box is not yet serving
# them. Every fault below must say that, because `die` is called from a dozen places and
# `set -e` aborts at rsync, ssh and poll failures that reach no branch at all.
on_publish_failure() {
    printf '\n\033[31m✗ %s is tagged and published, but the box was NOT cut over.\033[0m\n' "$TAG" >&2
    printf '  The tag is correct. Do NOT delete it and do NOT burn a version number.\n' >&2
    printf '  Re-run to resume:  bin/release --deploy\n' >&2
    printf '  If GitHub or the box is unreachable, the manual path is docs/deploy.md §3.\n\n' >&2
}
(( DRY_RUN )) || trap on_publish_failure ERR

if (( ! DEPLOY )); then
    printf '\n'
    ok "$TAG is tagged and published — NOT deployed"
    printf '  The box is still serving the previous release. To ship it:\n'
    printf '    bin/release --deploy\n\n'
    exit 0
fi

# ================================================================= 3. deploy ====
#
# The tree goes to the box, the box builds the image, and `bin/deploy` cuts it over. The
# build happens THERE on purpose: the owner's laptop runs a Linux VM to speak Docker at
# all, and a `docker build` on it is minutes of pinned cores for an artefact the box can
# produce natively.
log "deploying $TAG"

[[ -f .deploy.local ]] || die ".deploy.local is missing — copy .deploy.local.example and fill it in"
# shellcheck disable=SC1091
set -a; . ./.deploy.local; set +a
: "${HAMYAR_SSH:?HAMYAR_SSH is not set in .deploy.local}"
: "${HAMYAR_PATH:=/srv/mobishop}"

ssh -o BatchMode=yes -o ConnectTimeout=15 "$HAMYAR_SSH" true \
    || die "cannot reach $HAMYAR_SSH without a password prompt"

readonly IMAGE_TAG="hamyar-app:${HEAD_SHA:0:9}"

log "syncing the tree to $HAMYAR_SSH:$HAMYAR_PATH"
#
# ## The tree that ships is the TAG, not the working directory
#
# `git archive "$TAG"` into a temporary directory, and rsync THAT. The first draft synced
# `./`, which meant the image built on the box was the working copy — every untracked and
# gitignored file included. The published tarball, its SHA-256 and the tag all described a
# different tree, and asserted it with a checksum. On the first release cut by hand this
# put `docs/design-brief-v2-fa.md` and `ref-novin-hero.png` into the production build
# context; the next one could just as easily carry a scratch file in `app/` that CI never
# ran and nobody reviewed.
#
# Now the artefact and the tag are the same thing by construction rather than by
# discipline. `--delete` stays safe: production uploads live in the `app-storage` named
# volume (compose.prod.yaml), not in the synced `storage/` tree.
#
# --exclude 'docker/nginx/upstream/app.conf' is NOT optional. It is the one file that is
# both tracked and runtime state — the archive carries the committed blue-slot version, so
# syncing it would reset the live slot to app_blue while app_green may be the one serving.
# bin/deploy cross-checks against the running container, but this is the fix rather than
# the net.
if (( DRY_RUN )); then
    sync_src="./"
else
    export_dir="$(mktemp -d)"
    trap 'rm -rf "$export_dir"' EXIT
    git archive --format=tar "$TAG" | tar -x -C "$export_dir"
    sync_src="$export_dir/"
    ok "exported $TAG to a clean tree ($(find "$export_dir" -type f | wc -l | tr -d ' ') files)"
fi

run rsync -az --delete \
    --exclude '.env' \
    --exclude '.env.production' \
    --exclude '.deploy.local' \
    --exclude 'certbot' \
    --exclude 'docker/nginx/upstream/app.conf' \
    --exclude 'release/public' \
    "$sync_src" "$HAMYAR_SSH:$HAMYAR_PATH/"
ok "tree synced"

# Both remote steps run DETACHED, with their output on the box, and this script polls.
#
# Not defensive programming — a repair. The first deploy cut this way lost its SSH
# connection partway through `bin/deploy`, and because the command was a child of the
# session it died with it: traffic had been cut over, but the queue workers had not been
# recreated and one of them was left as a half-renamed container holding its own name, so
# the obvious retry failed with a name conflict. Horizon was down and nothing said so.
#
# `bin/deploy` is careful about ORDER — every irreversible step after every reversible one
# — and that guarantee assumes the script gets to run to the end. A dropped carrier is the
# one thing that can take it out between two steps, and it is also the failure this setup
# invites: a laptop over a long-haul link to Helsinki, mid-evening.
#
# So the box owns the process. A drop now costs a reconnect, not a half-deployed site.
remote_detached() {
    local name="$1" command="$2" log_file="/tmp/hamyar-release-$1.log"

    # ## `&` binds the LIST, not the last command — and that made this synchronous
    #
    # The first version of this line read
    #
    #     ssh … "cd '$PATH' && rm -f LOG LOG.done && nohup sh -c '…' >/dev/null 2>&1 & echo detached"
    #
    # In `A && B && C & D`, the `&` backgrounds the whole `A && B && C` list, not just C.
    # So the remote shell forked a subshell that ran cd, rm, and then WAITED on the nohup —
    # with its own stdout and stderr still attached to the ssh channel, because the
    # `>/dev/null 2>&1` applied to `nohup` alone. ssh does not close a channel while a
    # process still holds it, so the launch blocked for the entire remote run.
    #
    # It looked correct: "detached" came back at once, the deploy worked, the sentinel was
    # written. But the poll loop below never executed a single iteration, and the drop
    # protection this whole helper exists for was not there at all — a link failure would
    # have killed the remote command exactly as before. Measured rather than reasoned:
    # a 30-second remote command returned in 32.4s; the form below returns in 2.4s and the
    # remote work goes on to completion after the channel is gone.
    #
    # Three things make it real, and all three are load-bearing:
    #   `{ … & }` backgrounds only the nohup, so cd and rm stay in the foreground and their
    #             failures are still reported;
    #   `< /dev/null > /dev/null 2>&1` gives the background process none of the channel's
    #             descriptors to hold open;
    #   `setsid`  puts it in its own session, so tearing down the ssh session cannot signal
    #             it. `nohup` alone covers SIGHUP; it does not cover the session.
    ssh -n -o BatchMode=yes -o ConnectTimeout=15 "$HAMYAR_SSH" \
        "cd '$HAMYAR_PATH' && rm -f '$log_file' '$log_file.done' && \
         { setsid nohup sh -c '( $command ) > $log_file 2>&1; echo \$? > $log_file.done' \
           < /dev/null > /dev/null 2>&1 & } && echo detached" \
        || die "could not start $name on the box"

    # Poll for the sentinel rather than for the process: a finished run leaves an exit
    # code behind, so this reports the same answer whether or not the link survived it.
    #
    # Every poll is bounded in WALL CLOCK, not just in connect(). A blackholed route costs
    # ~75s per connect on macOS, and a box that completes the handshake and then stops
    # talking hangs the ssh forever — ConnectTimeout covers only the first of those, so
    # ServerAlive* is doing the real work here. (timeout(1) is not on macOS by default.)
    #
    # The budget is measured against SECONDS for the same reason: counting sleeps counts
    # only the time this loop chose to wait, so 30 minutes of sleep could be six hours of
    # wall clock once each ssh starts taking minutes to fail.
    local -a poll_ssh=(ssh -o BatchMode=yes -o ConnectTimeout=10
                       -o ServerAliveInterval=5 -o ServerAliveCountMax=3)
    local started=$SECONDS elapsed=0 unreachable=0 rc=0

    while :; do
        rc=0
        "${poll_ssh[@]}" "$HAMYAR_SSH" "test -f '$log_file.done'" 2>/dev/null || rc=$?
        (( rc == 0 )) && break

        # 255 is ssh itself failing; anything else is the remote `test` saying "not yet".
        # Collapsing the two is how a box that stopped answering reads as a long build.
        if (( rc == 255 )); then
            unreachable=$(( unreachable + 1 ))
            (( unreachable == 3 )) && warn "$HAMYAR_SSH has not answered for ~30s — $name may still be running on the box"
            (( unreachable < 60 )) || die "$HAMYAR_SSH unreachable for ~10 minutes during $name; the box may still be mid-$name — check $log_file there before re-running"
        else
            unreachable=0
        fi

        sleep 10
        elapsed=$(( SECONDS - started ))
        (( elapsed % 60 < 10 )) && log "  …$name still running (${elapsed}s)"
        (( elapsed < 1800 )) || die "$name has run for 30 minutes — look at $log_file on the box"
    done

    local code
    code="$(ssh "$HAMYAR_SSH" "cat '$log_file.done'" 2>/dev/null || echo unreadable)"

    if [[ "$code" != "0" ]]; then
        ssh "$HAMYAR_SSH" "tail -40 '$log_file'" >&2 || true
        printf '\033[31m✗ %s failed on the box (exit %s) — full output in %s\033[0m\n' "$name" "$code" "$log_file" >&2
        return 1
    fi
}

log "building $IMAGE_TAG on the box"
if (( DRY_RUN )); then
    printf '\033[90m   would run: docker build … -t %s (detached, on the box)\033[0m\n' "$IMAGE_TAG"
else
    # A build failure is clean: nothing on the box has moved, the previous release is
    # still serving, and the ordinary published-but-not-deployed advice is the right one.
    remote_detached build \
        "docker build -f docker/app/Dockerfile.prod --build-arg APP_RELEASE=$IMAGE_TAG -t $IMAGE_TAG ." \
        || die "the image did not build — nothing on the box has changed"
fi
ok "image built"

log "cutting over"
if (( DRY_RUN )); then
    printf '\033[90m   would run: bin/deploy %s (detached, on the box)\033[0m\n' "$IMAGE_TAG"
else
    # A deploy failure is NOT clean, and this is the one place that must not repeat the
    # box's own words. `bin/deploy`'s ERR trap says "nothing was cut over; the previous
    # release is still serving" — true for steps 1-6, a lie for steps 8 and 9, which run
    # AFTER traffic has moved. That is exactly the 2026-08-21 shape: the cutover succeeded,
    # the queue workers did not come up, the site looked perfect and stopped sending SMS.
    # Reading "nothing was cut over" there sends the operator away from the damage.
    if ! remote_detached deploy "bin/deploy $IMAGE_TAG"; then
        printf '\n\033[31m✗ bin/deploy failed on the box. Production state is UNKNOWN.\033[0m\n' >&2
        cat >&2 <<EOF

  The box's own message may say "nothing was cut over". Believe it only for a failure
  before step 7 — steps 8 (queue workers) and 9 (drain) run AFTER traffic has moved, and
  the same sentence is printed either way.

  Establish which happened before doing anything else:

    ssh $HAMYAR_SSH "cd '$HAMYAR_PATH' && \\
      cat docker/nginx/upstream/app.conf && \\
      docker compose -f compose.prod.yaml --env-file .env.production ps"

  The upstream file names the slot serving traffic; the image tags on horizon and
  scheduler say whether the queue followed it. A cut-over web tier with workers left on
  the old image is the failure that looks like success.

  Full output:  ssh $HAMYAR_SSH "cat /tmp/hamyar-release-deploy.log"

EOF
        exit 1
    fi
    ssh "$HAMYAR_SSH" "tail -20 '/tmp/hamyar-release-deploy.log'" || true
fi
ok "cut over"

# ---------------------------------------------------------------- 4. prove it ----
#
# Until this passes, the deploy is not a release — it is a hope. Both values come from
# the box's own .env.production, so nothing here needs a hostname or a secret written
# down anywhere (golden rule 1b). HEALTH_SECRET is read into this shell and never
# printed, logged or written.
log "smoke-checking the live site"

if (( DRY_RUN )); then
    printf '\033[90m   would run: bin/smoke <apex from the box>\033[0m\n\n'
    exit 0
fi

# Prints the value, or nothing, and NEVER returns non-zero.
#
# That last part is the whole point. This runs AFTER the cutover, and the first draft ended
# in a bare pipeline: under `set -Eeuo pipefail`, `grep -m1` finding nothing — or ssh
# exiting 255 on the dropped link this whole design exists to survive — made the assignment
# fail and killed the script silently, with the new image already live and no smoke check
# and no message at all. The operator saw "✓ cut over" and then a shell that ended with
# status 1. It also made the two guards below unreachable.
#
# Strips surrounding quotes, whitespace and a stray CR. Written as a function because doing
# it inline needs a `tr` argument that quotes both quote characters, which is how an even
# earlier draft silently produced an empty apex.
env_from_box() {
    local raw
    raw="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$HAMYAR_SSH" \
              "grep -m1 -- '^$1=' '$HAMYAR_PATH/.env.production'" 2>/dev/null)" || raw=''
    [[ -n "$raw" ]] || return 0
    printf '%s\n' "$raw" \
        | cut -d= -f2- \
        | sed -e 's/\r$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

apex="$(env_from_box APP_DOMAIN)"
secret="$(env_from_box HEALTH_SECRET)"

# From here the cutover has already happened, so nothing below may `die` as though it had
# not. Every branch says what is live before it says what is wrong.
if [[ -z "$apex" ]]; then
    printf '\n\033[33m! %s IS CUT OVER AND LIVE on the box, but it is UNVERIFIED.\033[0m\n' "$TAG" >&2
    printf '  APP_DOMAIN could not be read from %s/.env.production — the key is missing, or the ssh call failed.\n' "$HAMYAR_PATH" >&2
    printf '  Verify by hand:  HEALTH_SECRET=<secret> EXPECT_VERSION=%s EXPECT_RELEASE=%s bin/smoke <apex>\n\n' "$VERSION" "$IMAGE_TAG" >&2
    exit 1
fi

[[ -n "$secret" ]] \
    || warn "HEALTH_SECRET was not readable from the box — smoke cannot prove WHICH build answered"

if HEALTH_SECRET="$secret" EXPECT_VERSION="$VERSION" EXPECT_RELEASE="$IMAGE_TAG" bin/smoke "$apex"; then
    trap - ERR
    printf '\n'
    ok "released and verified: $TAG is live on $apex as $IMAGE_TAG"
    printf '  https://%s/\n' "$apex"
    printf '  Append the line to docs/PROGRESS.md and the roadmap box is honestly ticked.\n\n'
else
    trap - ERR
    printf '\n'
    printf '\033[31m✗ %s is deployed and serving, but did NOT pass smoke.\033[0m\n' "$TAG" >&2
    printf '  The cutover happened. This is a live release that is failing its own checks.\n' >&2
    printf '  Roll back (a cutover, not a rebuild — the previous container is stopped, not removed):\n' >&2
    printf "    ssh %s \"cd '%s' && bin/deploy <previous-image> --rollback\"\n" "$HAMYAR_SSH" "$HAMYAR_PATH" >&2
    printf '  Or roll forward: fix, merge, bump VERSION, and release again.\n\n' >&2
    exit 1
fi
