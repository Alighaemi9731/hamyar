# =============================================================================
#  MobiShop — environment
#  Copy to .env (`cp .env.example .env`), then `make up && make fresh`.
#  Every key is documented; if you add one, document it here too.
# =============================================================================

# --- application -------------------------------------------------------------
APP_NAME=MobiShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Central (non-tenant) host. Tenants live on subdomains of APP_DOMAIN.
APP_URL=http://app.localhost
# Bare domain used to build and match tenant subdomains: demo.app.localhost.
# Must NOT include a scheme or port.
APP_DOMAIN=app.localhost

# Host port nginx binds to. Set to 8080 if binding :80 needs privileges on your
# machine (common with colima/rootless Docker); then browse http://app.localhost:8080.
APP_HTTP_PORT=80

# --- locale & calendar -------------------------------------------------------
# UI is Persian; English is only the fallback for untranslated framework strings.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

# Golden rule 5: timestamps are STORED as UTC. APP_TIMEZONE must stay UTC.
APP_TIMEZONE=UTC
# Wall-clock timezone used when rendering Jalali dates. Never stored.
APP_DISPLAY_TIMEZONE=Asia/Tehran

# Default money display unit for new tenants: rial or toman.
# Golden rule 2: storage is always integer rial regardless of this setting.
APP_CURRENCY_DISPLAY=toman

APP_MAINTENANCE_DRIVER=file

# --- logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- database ----------------------------------------------------------------
# `postgres` is the compose service name. From the host use 127.0.0.1:5432.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mobishop

# The application connects as a NON-superuser role on purpose: superusers bypass
# Row-Level Security, which is our second line of tenancy defence (ADR 0002).
# Migrations, seeders and tests use this same role.
DB_USERNAME=mobishop_app
DB_PASSWORD=app-secret

# Superuser, created by the Postgres image. Infrastructure only — `make psql`,
# backups, manual surgery. NOTE: queries run as this role see ALL tenants.
DB_ROOT_USERNAME=mobishop
DB_ROOT_PASSWORD=secret

# Host-side ports (only used to avoid clashes with a local Postgres/Redis).
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379

# --- redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- cache / session / queue -------------------------------------------------
CACHE_STORE=redis
# DATABASE, not redis: the session-management screen enumerates a user's
# sessions, which the redis driver cannot do without a parallel index we would
# have to keep correct ourselves. Redis still backs cache and queues.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookies are HOST-ONLY: each tenant subdomain gets its own session cookie.
#
# A leading-dot domain (.app.localhost) shares one cookie across every subdomain,
# which means a session established at shop-a can be presented to shop-b. Laravel
# would then resolve the stored user id against shop-b's scoped provider — and if
# shop-b happens to have a user with the same numeric id, the visitor is silently
# authenticated as that person. Leave this EMPTY.
SESSION_DOMAIN=

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# --- filesystem / S3 (MinIO in dev) ------------------------------------------
# Tenant media is stored under a per-tenant prefix on this disk (ADR 0002, Files module).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=mobishop
AWS_SECRET_ACCESS_KEY=mobishop-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mobishop
AWS_ENDPOINT=http://minio:9000
# URL the browser uses; the container endpoint above is not reachable from the host.
AWS_URL=http://localhost:9000/mobishop
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001

# --- mail (mailpit in dev) ---------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
# Interpolated from APP_DOMAIN, not written out. `mobishop.ir` is a working name and
# was sitting here as a literal — so every developer copying this file, and any box
# that forgot to override it, sent mail claiming to be from a domain nobody owns.
# Golden rule 1b, and it is enforced by bin/check-apex-domain.
MAIL_FROM_ADDRESS="no-reply@${APP_DOMAIN}"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_SMTP_PORT_HOST=1025
MAILPIT_UI_PORT_HOST=8025

# --- security ----------------------------------------------------------------
# Argon2id is the chosen hasher (ADR 0001 / master plan §11).
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# --- vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
#  Integrations — all inert until their phase lands. Sandbox/fake by default so
#  no real SMS is sent and no real money moves from a dev machine.
# =============================================================================

# --- payments: Zarinpal via shetabit/multipay (Phase 2) ----------------------
PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- SMS (Phase 8) -----------------------------------------------------------
# `log` writes to the log instead of sending. Switch to kavenegar only with credentials.
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
SMSIR_API_KEY=

# --- Moadian / tax e-invoicing (Phase 10) ------------------------------------
MOADIAN_ENABLED=false
MOADIAN_DRIVER=fake
MOADIAN_BASE_URL=
MOADIAN_MEMORY_ID=
MOADIAN_PRIVATE_KEY=

# --- observability (Phase 11) ------------------------------------------------
# Empty here and on every developer machine, which is the whole design: with no DSN
# the Sentry SDK is loaded, wired and completely silent. Nothing needs to be
# conditionally registered, so the reporter that runs in production is the same one
# that has been running everywhere else all along.
#
# What it sends is decided in config/sentry.php, not here — no PII, no SQL bindings,
# request bodies scrubbed through App\Support\SensitiveInput, and the shop tagged by
# id and slug so an incident can name a tenant without carrying anyone's data.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set by bin/deploy from the image tag so a report can name the code it came from.
SENTRY_RELEASE=

# Unlocks the detailed body of /health for a caller presenting it as X-Health-Secret.
# Unset (as here) means NOBODY sees the detail — the endpoint still answers, with a
# bare ok/unhealthy and the right status code, which is all an uptime probe needs.
# Generate one for production: `openssl rand -hex 32`.
HEALTH_SECRET=

# --- queue dashboard (Phase 11) ----------------------------------------------
# Horizon answers on the central domain only. Left unset it follows APP_DOMAIN, which
# is what you want — it is set separately only when the dashboard lives somewhere else.
# Access is gated on the `platform` guard (App\Providers\HorizonServiceProvider), and
# that is a tenancy boundary rather than an admin nicety: the dashboard renders job
# payloads, which carry every shop's SMS text and customers' phone numbers.
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# --- backups (Phase 11, production only) -------------------------------------
# Read by bin/backup-nightly. Local dumps are pruned after RETENTION_DAYS; remote
# retention is a lifecycle rule on the bucket, deliberately not a delete loop in the
# script — a bug there must not be able to erase the last copies.
BACKUP_LOCAL_DIR=/var/backups/mobishop
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
# Only for an S3-compatible provider that is not AWS (Arvan, Liara, MinIO).
BACKUP_S3_ENDPOINT=
