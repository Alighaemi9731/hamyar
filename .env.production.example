# =============================================================================
#  MobiShop — production environment.
#
#  Copy to .env.production ON THE SERVER, fill in every «CHANGE-ME», and never
#  commit it. compose.prod.yaml reads this file; the application image contains
#  no configuration at all, deliberately — see docker/app/Dockerfile.prod.
#
#  Everything marked CHANGE-ME is either a secret or the one fact that differs
#  between this repository and the machine it runs on. There is nothing else to
#  edit: no code, no compose file, no nginx config.
# =============================================================================

# --- identity ----------------------------------------------------------------
APP_NAME=MobiShop
APP_ENV=production
APP_DEBUG=false

# `php artisan key:generate --show` once, then BACK IT UP SEPARATELY FROM THE
# DATABASE. It decrypts `device_passcode`, the Moadian private key and every other
# encrypted column: a database restored without this key is unreadable where it
# matters most, and a backup containing both is one theft rather than two.
APP_KEY=CHANGE-ME

# The apex, with no scheme and no port — this is the ONLY place it is written down.
# nginx reads it from here (envsubst), route domain constraints read it through
# config('app.domain'), and tenants resolve from `domains.hostname` rows. Changing it
# is this line plus a data migration, never a code change (golden rule 1b).
APP_DOMAIN=CHANGE-ME
APP_URL=https://CHANGE-ME

# The release to deploy. bin/deploy overrides this per run; it lives here so a plain
# `docker compose up -d` after a reboot starts the release that was last deployed
# rather than failing or, worse, silently pulling `latest`.
APP_IMAGE=CHANGE-ME

# The certbot image, and it is a CHANGE-ME because a wildcard needs DNS-01 and the DNS
# plugin ships per provider: certbot/dns-cloudflare, certbot/dns-route53,
# certbot/dns-digitalocean, and so on. `certbot/certbot` contains NO plugins at all, so
# leaving it there issues nothing and — far worse — renews nothing: every renewal
# attempt exits with "Could not select or initialize the requested authenticator
# dns-<provider>", twice a day, quietly, into a container log nobody reads, until the
# certificate expires and takes every tenant offline at the same moment.
#
# With an Iranian registrar that has no plugin, this stays certbot/certbot and the
# certificate is issued with `--manual --preferred-challenges dns` — which cannot
# auto-renew, and makes the expiry alert in docs/deploy.md §5 mandatory rather than nice.
CERTBOT_IMAGE=certbot/dns-cloudflare:latest

# --- locale ------------------------------------------------------------------
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Tehran
APP_CURRENCY_DISPLAY=toman
APP_MAINTENANCE_DRIVER=file

# --- logging -----------------------------------------------------------------
# stderr, not a file: Docker's json-file driver collects it with rotation already
# configured in compose.prod.yaml. Logging to a file inside a container means logs
# that vanish with the container and a disk that fills without anybody watching.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- database ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mobishop

# NOT a superuser, and this is the tenancy guarantee rather than good practice:
# superusers bypass Row-Level Security unconditionally, so an application connecting
# as one has no isolation between shops at all — with every test still green, because
# the tests connect as this role (ADR 0002).
DB_USERNAME=mobishop_app
DB_PASSWORD=CHANGE-ME

# Superuser. Used by the init scripts, `pg_dump` and manual surgery — never by the
# application. Queries as this role see EVERY tenant's data.
DB_ROOT_USERNAME=mobishop
DB_ROOT_PASSWORD=CHANGE-ME

# --- redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME

# --- cache / session / queue -------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/

# MUST stay empty. A leading-dot domain shares one session cookie across every
# subdomain, so a session established at shop-a can be presented to shop-b — and if
# shop-b has a user with the same numeric id, the visitor is silently authenticated
# as that person. Host-only cookies are what stop that.
SESSION_DOMAIN=

# HTTPS everywhere in production, so the cookie should never travel in clear.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# --- object storage ----------------------------------------------------------
# Tenant media, under a per-tenant prefix (ADR 0002, Files module).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE-ME
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_DEFAULT_REGION=CHANGE-ME
AWS_BUCKET=CHANGE-ME
# Only for an S3-compatible provider that is not AWS (Arvan, Liara).
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=CHANGE-ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
MAIL_SCHEME=tls
# Interpolated, never a literal — same rule as APP_DOMAIN above.
MAIL_FROM_ADDRESS="no-reply@${APP_DOMAIN}"
MAIL_FROM_NAME="${APP_NAME}"

# --- security ----------------------------------------------------------------
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# --- observability -----------------------------------------------------------
SENTRY_LARAVEL_DSN=CHANGE-ME
SENTRY_TRACES_SAMPLE_RATE=0.1
# Overridden per release by bin/deploy.
SENTRY_RELEASE=

# `openssl rand -hex 32`. Unlocks the detail on /health for the uptime probe and for
# whoever is on the box at 3am. Unset means the endpoint still answers ok/unhealthy
# and simply describes nothing, which is the safe default rather than the broken one.
HEALTH_SECRET=CHANGE-ME

HORIZON_DOMAIN=
HORIZON_PATH=horizon

# --- backups -----------------------------------------------------------------
BACKUP_LOCAL_DIR=/var/backups/mobishop
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=CHANGE-ME
BACKUP_S3_ENDPOINT=

# --- integrations ------------------------------------------------------------
# Live credentials. Everything below moves real money or sends real messages, so it
# is the last section on purpose: getting here means everything above is done.
PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=CHANGE-ME
ZARINPAL_SANDBOX=false

SMS_DRIVER=kavenegar
KAVENEGAR_API_KEY=CHANGE-ME
KAVENEGAR_SENDER=CHANGE-ME
SMSIR_API_KEY=

# Left off until a Moadian provider is contracted (ADR 0011 — adapter, no provider).
MOADIAN_ENABLED=false
MOADIAN_DRIVER=fake
MOADIAN_BASE_URL=
MOADIAN_MEMORY_ID=
MOADIAN_PRIVATE_KEY=
