# --- Hamyar ---
# .claude/skills/ and .claude/commands/ ARE tracked on purpose: the design-system skill
# and the release commands ship with the repo.
.claude/settings.local.json

# Impeccable (design tooling). `.impeccable/config.json`, `design.json` and the surface
# briefs are shared and tracked; everything below is per-machine or per-run scratch —
# hook consent, live-mode injection state, review captures, comps and build state.
.impeccable/config.local.json
.impeccable/live/
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
.impeccable/cache/
.impeccable/critiques/

# Operator coordinates for the production box — host, path, deploy directory. Not
# secrets, but the repository is PUBLIC, so they live on the machine that deploys and
# nowhere else (golden rule 1b, and docs/RELEASE_PROCESS.md).
.claude/OPS.local.md
.deploy.local

# Release archives built by bin/release. They are uploaded to the GitHub release; the
# repository is not where a build artefact belongs.
/dist-release/
_tmp/
/bin/.phpstan-cache

# --- Laravel ---
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
.env
.env.backup
.env.production
/auth.json
*.log
.phpunit.result.cache
/.phpunit.cache
/.phpstan.cache
Homestead.json
Homestead.yaml

# --- editors & OS ---
/.idea
/.fleet
/.nova
/.vscode
/.zed
.phpactor.json
.DS_Store
Thumbs.db
/.playwright-mcp/
# Playwright writes a screenshot wherever `filename` resolves to, and a bare name
# resolves to the repository root rather than into .playwright-mcp/ above. One reached
# a commit that way; this is cheaper than remembering.
/*.png

# Pest browser-test failure screenshots — diagnostic output, uploaded by CI as an
# artifact rather than committed.
/tests/Browser/Screenshots

# `DirectionClassGateTest` writes a throwaway .tsx here to prove the RTL gate flags a
# physical direction class, then deletes it. It exists for milliseconds — which is long
# enough for a `git add -A` running beside the suite to catch it, and that is exactly how
# it once reached a commit and turned the RTL gate red on a branch that was clean locally.
# The gate then failed on CI for a violation the fixture is *supposed* to contain.
/resources/js/__gate_fixture
