# Copy to `.deploy.local` (gitignored) and fill in. Coordinates, not secrets:
# no passwords, no tokens, no HEALTH_SECRET — bin/release reads that off the box
# itself, from the .env.production that already holds it.
#
# The repository is public. This file is why that is safe.

# Where `bin/release --deploy` sends the tree. Anything ssh(1) accepts.
HAMYAR_SSH=root@203.0.113.10

# The deploy directory on that box. An rsync'd copy of the tree, NOT a git checkout.
HAMYAR_PATH=/srv/mobishop
